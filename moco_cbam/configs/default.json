{
  "common": {
    "feature_dim": 512, "K": 4096, "m": 0.995, "T": 0.07,
    "use_gpu": true,
    "img_suffix": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff"],
    "image_preprocess": {"resize": 224, "mean": [0.5, 0.5, 0.5], "std": [0.5, 0.5, 0.5]}
  },
  "train": {
    "train_csv": "data/splits/train.csv", "val_csv": "data/splits/val.csv",
    "test_csv": "data/splits/test.csv", "batch_size": 128,
    "learning_rate": 0.0001, "num_epochs": 200, "patience": 7,
    "checkpoint_dir": "moco_cbam/checkpoints/moco_cbam", "num_workers": 0,
    "pin_memory": false, "use_augment": true, "weight_decay": 0.0001,
    "lr_scheduler": "plateau", "save_every": 10
  },
  "extraction": {
    "image_dir": "data/gallery", "model_path": "moco_cbam/checkpoints/moco_cbam/best_model.pth",
    "output_feats": "outputs/moco_cbam/gallery_feats.pt", "use_gpu": true
  },
  "batch_retrieval": {
    "model_path": "moco_cbam/checkpoints/moco_cbam/best_model.pth",
    "feature_path": "outputs/moco_cbam/gallery_feats.pt",
    "output_folder": "outputs/moco_cbam/retrieval", "query_groups_json": "data/query_groups.json",
    "top_k": 10, "use_gpu": true
  }
}
