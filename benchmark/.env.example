# Copy to .env locally; replace /absolute/... examples with absolute paths.
# The dotenv reader performs no variable interpolation.
LIBRARY_BINARY=/absolute/path/to/library_binary
TEST_BINARY_ROOT=/absolute/path/to/binary_ginseng
MERGED_GALLERY=/absolute/path/to/library_query_datasets
# Repository root containing single_topo/, simclr/, moco/, and moco_cbam/.
MAIN_CODE_ROOT=/absolute/path/to/ginseng
# Author-supplied splits; DEV_CSV is NOT the independent Re-ID test set.
TRAIN_CSV=/absolute/path/to/splits/train.csv
VAL_CSV=/absolute/path/to/splits/val.csv
DEV_CSV=/absolute/path/to/splits/test.csv
ARTIFACT_ROOT=/absolute/path/to/ginseng/benchmark/artifacts
HF_TOKEN=
HF_HOME=/absolute/path/to/ginseng/benchmark/artifacts/models/huggingface
HF_HUB_CACHE=/absolute/path/to/ginseng/benchmark/artifacts/models/huggingface/hub
HF_HUB_DISABLE_PROGRESS_BARS=0
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=60
HF_HUB_DISABLE_SYMLINKS_WARNING=1
DINOV2_WEIGHTS=
TRANSREID_ROOT=/absolute/path/to/ginseng/benchmark/third_party/TransReID
TRANSREID_CONFIG=
TRANSREID_CHECKPOINT=
